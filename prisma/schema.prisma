// TV Tracker — schema with per-user data (v2).
// See docs/technical-design.md section 2 and docs/technical-design-v2.md.
//
// **Phase B is applied.** `userId` is required on the three per-user tables,
// and their unique constraints are composite. The consequence worth knowing
// before touching a query: `Show.tracked` and `Episode.watched` are **lists**,
// not single rows — one entry per user tracking that show. A query that reads
// them without filtering by userId returns other people's data.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// An account. A code *is* the account — no email, no PII, matching v1's
/// "collects no personal data at all" stance. Codes are generated by the admin
/// and handed out directly; there is no self-serve signup.
model User {
  id String @id @default(cuid())

  /// SHA-256 of the account code, never the code itself. A dump of this
  /// database reveals no usable credential. Deterministic (not bcrypt) so a
  /// login is one indexed lookup rather than a scan comparing every row —
  /// defensible because codes are 128-bit server-generated tokens, not
  /// low-entropy user-chosen passwords.
  ///
  /// The code is an invite, not the day-to-day credential: it gets you through
  /// first login, and remains valid afterwards as the only way back in if the
  /// password is forgotten. There is no other recovery route.
  codeHash String @unique

  /// scrypt, salted, with its parameters stored alongside — see lib/password.ts
  /// for why this is hashed completely differently from `codeHash`. Null until
  /// first login, like `nickname`; an account is only usable once both are set.
  passwordHash String?

  /// Chosen on first login, not at account creation, so it starts null. The
  /// application enforces "required" by letting a session with no nickname
  /// reach nothing but the setup page — a NOT NULL column couldn't, because
  /// the row has to exist before its owner has ever logged in.
  nickname String?

  /// Lowercased `nickname`, carrying the uniqueness constraint, because
  /// "Theo" and "theo" are the same nickname. Prisma's DSL can't declare
  /// SQLite's COLLATE NOCASE, and hand-editing it into the generated SQL would
  /// be silently dropped by the next migration that touches this model —
  /// tests build their database from these files, so nothing would catch it.
  nicknameKey String? @unique

  /// Consecutive failed password attempts, reset on any successful sign-in.
  /// Counted per account rather than per IP: an in-process counter is useless
  /// across short-lived serverless instances (see the note in proxy.ts), and
  /// the account is the thing actually being attacked.
  failedLogins Int @default(0)

  /// Set once `failedLogins` crosses the threshold; password sign-in is
  /// refused until it passes. Signing in with the account code clears it, so a
  /// stranger tripping someone else's lockout cannot keep them out — the code
  /// is unguessable and is the documented way back in regardless.
  lockedUntil DateTime?

  createdAt DateTime @default(now())

  trackedShows    TrackedShow[]
  watchedEpisodes WatchedEpisode[]
  settings        Settings?
  sessions        Session[]
}

/// A logged-in session. Stored rather than signed into a stateless cookie so a
/// single compromised session can be revoked without logging everyone out —
/// which matters more here than usual, because a lost code has no recovery
/// path at all.
model Session {
  /// SHA-256 of the opaque token in the cookie, same reasoning as `codeHash`.
  id String @id

  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  /// For the daily sweep of expired rows; nothing else deletes them.
  @@index([expiresAt])
}

/// A show as cached from TMDB. Populated when a show is first tracked so we
/// aren't hitting the TMDB API on every page load.
model Show {
  id         String   @id // TMDB show id, stored as a string
  name       String
  posterPath String?
  overview   String?
  lastSynced DateTime @default(now()) // last refresh of episode data from TMDB

  /// Metadata for the line under the synopsis. All of it arrives in the same
  /// `/tv/{id}` response the sync already makes, so none of it costs a request.
  firstAirDate DateTime?
  lastAirDate  DateTime?
  /// TMDB's lifecycle value: "Ended", "Returning Series", "In Production" are
  /// the ones seen in practice. Note cancelled shows are usually reported as
  /// "Ended" rather than "Canceled", so don't rely on that value existing.
  status       String?
  /// Primary network only — TMDB lists co-producers that add noise.
  network      String?
  /// Comma-separated; there are rarely more than three and a join table would
  /// be overkill for something only ever rendered as a single string.
  genres       String?

  episodes Episode[]
  tracked  TrackedShow[]
}

/// A single episode of a cached show, including its air date.
model Episode {
  id            String    @id // TMDB episode id
  showId        String
  seasonNumber  Int
  episodeNumber Int
  name          String?
  airDate       DateTime?
  /// Minutes. Comes free with the season fetch; also what a future
  /// "hours watched" stat would be built on.
  runtime       Int?
  overview      String?

  show    Show            @relation(fields: [showId], references: [id], onDelete: Cascade)
  watched WatchedEpisode[]

  /// Composite rather than `showId` alone: both episode-list reads filter by
  /// show and order by season then episode, so with only the show column SQLite
  /// fetched the rows and then sorted them in memory — on every dashboard,
  /// watchlist, archive and show-page render. Leading with `showId` means this
  /// also serves everything the bare index did, including `setSeasonWatched`'s
  /// `showId + seasonNumber` filter, so keeping both would just be a second
  /// index to maintain on every write.
  @@index([showId, seasonNumber, episodeNumber])
  @@index([airDate])
}

/// A show the user has added to "watching" or their watchlist.
model TrackedShow {
  id      String   @id @default(cuid())
  showId  String
  userId  String
  status  String // "watching" | "watchlist" | "paused" | "stopped"
  addedAt DateTime @default(now())

  show Show @relation(fields: [showId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Two people may track the same show; one person may not track it twice.
  @@unique([userId, showId])
  /// The cron reads every tracked showId across all users.
  @@index([showId])
}

/// Marks one episode as watched. Presence of the row is the "watched" flag.
model WatchedEpisode {
  id        String   @id @default(cuid())
  episodeId String
  userId    String
  watchedAt DateTime @default(now())

  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
  @@index([episodeId])
}

/// One row of preferences per account, keyed by the user it belongs to. Kept
/// in the database rather than a file, which Vercel would wipe on redeploy.
model Settings {
  /// One row per user, replacing v1's fixed id=1 single row.
  userId        String  @id
  notifyEnabled Boolean @default(false)
  /// ISO 3166-1 alpha-2 code (e.g. "FR"), used as the default region when
  /// showing where a series is available to stream. Null until you pick one.
  country       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Phase B is done. What it left behind, for anyone reading a query here:
//
//   - `Show.tracked` and `Episode.watched` are lists. Every read through them
//     must filter by userId, or it returns rows belonging to someone else.
//     `getUpcomingEpisodes` is the one where the wrong version still compiles.
//   - `Settings` is keyed by userId; there is no id=1 row any more.
//   - The global TMDB cache (`Show`, `Episode`) is deliberately NOT per-user.
//     Two people tracking the same show share one cached copy.
