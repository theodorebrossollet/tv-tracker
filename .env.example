# Copy this file to `.env` and fill in the values. `.env` is gitignored —
# never commit real keys.

# Your TMDB API read access token or API key.
# Get one free at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Local SQLite file. See docs/technical-design.md section 9 for the note about
# SQLite not being writable on Vercel.
DATABASE_URL="file:./dev.db"

# Shared secret protecting /api/cron/refresh-episodes so only Vercel Cron can
# trigger a refresh. Generate one with: openssl rand -hex 32
CRON_SECRET=
