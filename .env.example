# Copy this file to `.env` and fill in the values. `.env` is gitignored —
# never commit real keys.

# Your TMDB API read access token or API key.
# Get one free at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Where the database lives.
#   Local development: a plain SQLite file, no auth token needed.
#   Production (Turso): libsql://your-db-name-you.aws-eu-west-1.turso.io
DATABASE_URL="file:./dev.db"

# Only needed when DATABASE_URL is a libsql:// URL. Get it with:
#   turso db tokens create <your-db-name>
TURSO_AUTH_TOKEN=

# Shared secret protecting /api/cron/refresh-episodes so only Vercel Cron can
# trigger a refresh. Generate one with: openssl rand -hex 32
CRON_SECRET=

# Password for the whole app. v1 has no accounts and server actions accept
# direct POSTs, so a deployed instance without this would let anyone read or
# erase your data. Leave blank locally; REQUIRED in production, where the app
# refuses to serve without it. Any username works at the browser prompt.
#
# Generate it, don't invent it:  openssl rand -hex 32
#
# You type this once and let the browser remember it, so length costs you
# nothing — and it is what actually makes guessing hopeless. The proxy's delay
# on a wrong password only slows a serial guesser; a memorable password stays
# guessable however long the delay is.
APP_PASSWORD=
